{% extends 'base.html.twig' %}

{% block title %}Client index{% endblock %}

{% block body %}
    <main>

        <div class="searchBarWrapper">
            <input type="text" id="searchBar" class="searchBar" placeholder="Rechercher des clients...">
        </div>

        <div class="backgroundScrollerWrapper">
            <div class="scrollerWrapper">
                <section class="scrollerHeader">
                    <h2 class="scrollerHeaderText">clients enregistrés</h2>
                    <i class="bi bi-arrow-down acc absolute scrollerHeaderArrow"></i>
                    <a style="cursor: pointer" id="createClientButton" title="Ajouter un client" class="bi bi-person-plus scrollerHeaderIcon"></a>
                </section>

                <section class="scrollerContent">
                    {% for client in clients %}
                        <a href="{{ path('app_client_show', {'id': client.id}) }}" content="client" class="scrollerCard client" id="{{ client.id }}">
                            <section class="scrollerCardInnerCircle">
                                <span>{{ client.name|slice(0, 2) }}</span>
                            </section>

                            <section class="scrollerCardContent">
                                <div>
                                    <h3>{{ client.name}}</h3>
                                    {% if client.email %}
                                        <h4>{{ client.email }}</h4>
                                    {% else %}
                                        <h4>{{ client.tel }}</h4>
                                    {% endif %}
                                </div>

                                <span class="interStatut">
                                    <i class="bi bi-chevron-right"></i>
                                </span>
                            </section>
                        </a>
                    {% endfor %}
                </section>
            </div>
        </div>
    </main>

    <div id="clientModal" class="clientModal">
        <div class="clientModalContent">
            <span class="clientModalClose">&times;</span>
            <div id="clientModalBody" class="clientModalBody">
                <!-- Form will be loaded here -->
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/client.js') }}"></script>
    <script src="{{ asset('js/recherche.js') }}"></script>
{% endblock %}
