{% extends 'base.html.twig' %}

{% block title %}Client{% endblock %}

{% block body %}
    <main>
        <div class="clientWrapper">
            <article class="card">
                <a id="editClientButton" data-client-id="{{ client.id }}"><i class="bi bi-pencil-square"></i></a>
                <div class="cardSection contentSection">
                    <section class="cardCircle">
                        <i class="bi bi-person-fill"></i>
                    </section>
                    <h2 class="">{{ client.name }}</h2>
                    <h3 class="">{{ client.tel }}</h3>
                    <h4 class="">{{ client.email }}</h4>
                    <section class="dateWrap">
                        <p>Ajouté le : {{ client.createdAt|date('d/m/Y') }}</p>
                    </section>
                </div>
            </article>
        </div>

        <div class="backgroundScrollerWrapper">
            <div class="scrollerWrapper">
                <section class="scrollerHeader">
                    <h2 class="scrollerHeaderText">{{ interventions|length }} Interventions</h2>
                    <i class="bi bi-arrow-down acc absolute scrollerHeaderArrow"></i>
                    <a id="createInterventionButton" data-client-id="{{ client.id }}" class="bi bi-journal-plus scrollerHeaderIcon" style="cursor: pointer"></a>
                </section>

                <section class="scrollerContent">
                    {% for inter in interventions %}
                        <a href="{{ path('app_intervention_show', {'id': inter.id}) }}" content="intervention" class="scrollerCard" id="{{ inter.id }}">
                            <section class="scrollerCardInnerCircle">
                                <span>{{ inter.client.name|slice(0, 2) }}</span>
                            </section>

                            <section class="scrollerCardContent">
                                <div>
                                    <h3>{{ inter.Materiel }}</h3>
                                    <p class="prob">{{ inter.Probleme }}</p>
                                    {% if inter.finishedAt %}
                                        <span>Clôturé le : {{ inter.finishedAt|date('d/m/Y H:i') }}</span>
                                    {% else %}
                                        <span>Ajouté le : {{ inter.createdAt|date('d/m/Y H:i') }}</span>
                                    {% endif %}
                                </div>

                                <span class="interStatut">
                                    {% if inter.statut == 0 %}
                                        <i class="bi bi-x-circle" title="Non traité"></i>
                                    {% elseif inter.statut == 1 %}
                                        <i class="bi bi-clock"  title="En cours"></i>
                                    {% elseif inter.statut == 2 %}
                                        <i class="bi bi-check-circle"  title="Terminé"></i>
                                    {% endif %}
                                </span>
                            </section>
                        </a>
                    {% endfor %}
                </section>
            </div>
        </div>
    </main>

    <div id="interventionModal" class="interventionModal">
        <div class="interventionModalContent">
            <span class="interventionModalClose">&times;</span>
            <div id="interventionModalBody" class="interventionModalBody">
                <!-- Form will be loaded here -->
            </div>
        </div>
    </div>

    <div id="editClientModal" class="clientModal">
        <div class="clientModalContent">
            <span class="clientModalClose">&times;</span>
            <div id="editClientModalBody" class="clientModalBody">
                <!-- Form will be loaded here -->
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/intervention.js') }}"></script>
    <script src="{{ asset('js/client.js') }}"></script>
{% endblock %}
