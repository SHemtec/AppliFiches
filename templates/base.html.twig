<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset("css/styleOl.css") }}">
        <link rel="stylesheet" href="{{ asset("css/variables.css") }}">
        <link rel="stylesheet" href="{{ asset("css/styleNew.css") }}">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">


        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href='https://unpkg.com/boxicons@2.0.7/css/boxicons.min.css' rel='stylesheet'>
        <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        {% block stylesheets %}
        {% endblock %}
    </head>
    <body>
    {% if app.request.attributes.get('_route') != 'app_login' %}
    {% include '_partials/nav.html.twig' %}
    {% endif %}

    <div class="preloadWrapper">
        <div class="loader">
            <div class="loader-progress"></div>
        </div>
    </div>

    {% block body %}
    {% endblock %}

    {% block javascripts %}
    {% endblock %}

    <div class="flash-messages">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <span class="flash-message">
                    <span class="iconContainer flash-message-{{ type }}">
                        {% if type == 'success' %}
                            <i class="bi bi-check-circle"></i>
                        {% elseif type == 'danger' %}
                            <i class="bi bi-x-circle"></i>
                        {% elseif type == 'error' %}
                            <i class="bi bi-x-circle"></i>
                        {% elseif type == 'warning' %}
                            <i class="bi bi-exclamation-circle"></i>
                        {% elseif type == 'info' %}
                            <i class="bi bi-info"></i>
                        {% endif %}
                    </span>
                    {{ message }}
                </span>
            {% endfor %}
        {% endfor %}
    </div>

    <script id="flashes">
        document.addEventListener('DOMContentLoaded', function() {
            const flashMessages = document.querySelectorAll('.flash-message');
            flashMessages.forEach(function(message) {
                setTimeout(function() {
                    message.classList.add('slide-out');
                    setTimeout(function() {
                        message.remove();
                    }, 500);
                }, 3500);

                message.addEventListener('click', function() {
                    message.classList.add('slide-out');
                    setTimeout(function() {
                        message.remove();
                    }, 500);
                });

                const closeButton = message.querySelector('.flash-close');
                if (closeButton) {
                    closeButton.addEventListener('click', function(event) {
                        event.stopPropagation();
                        message.classList.add('slide-out');
                        setTimeout(function() {
                            message.remove();
                        }, 500);
                    });
                }
            });
        });
    </script>

    <script id="preloader">
        document.addEventListener('DOMContentLoaded', function () {
            const loaderProgress = document.querySelector('.loader-progress');
            const preloadWrapper = document.querySelector('.preloadWrapper');
            const mainContent = document.querySelector('body'); // Select the main content
            let preloaderTimeout;
            function updateLoaderProgress() {
                const totalHeight = document.body.scrollHeight - window.innerHeight;
                const scrolledHeight = window.scrollY;
                const progress = (scrolledHeight / totalHeight) * 100;
                loaderProgress.style.width = progress + '%';
            }

            // Set a timeout to show the preloader after 0.5 seconds
            preloaderTimeout = setTimeout(function () {
                preloadWrapper.style.display = 'flex';
            }, 500);

            window.addEventListener('scroll', updateLoaderProgress);
            window.addEventListener('load', function () {
                clearTimeout(preloaderTimeout); // Clear the timeout if the page loads within 0.5 seconds
                loaderProgress.classList.add('visible'); // Fade in the progress bar
                loaderProgress.style.width = '100%';
                setTimeout(function () {
                    preloadWrapper.classList.add('hidden');
                    setTimeout(function () {
                        preloadWrapper.remove(); // Completely remove the preloader
                        mainContent.classList.remove('hidden-content'); // Show the main content
                    }, 500); // Wait for the fade-out transition to complete
                }, 500); // Start fading out the preloader after 0.5 seconds
            });

            updateLoaderProgress(); // Initial call to set the progress
        });
    </script>
    </body>
</html>
