{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

    <main class="accueilContainer">

        <div class="acceuilStats">
            <article class="accueilStatCard">
                <section class="iconContainer">
                    <div class="iconCircle">
                        <i class="bi bi-person-fill"></i>
                    </div>
                </section>

                <section class="statContent">
                    <h3>{{ clientCount }}</h3>
                    <h4>Clients enregistrés</h4>
                </section>
            </article>

            <article class="accueilStatCard">
                <section class="iconContainer">
                    <div class="iconCircle">
                        <i class="bi bi-journal-text"></i>
                    </div>
                </section>

                <section class="statContent">
                    <h3>{{ interventionCount }}</h3>
                    <h4>Interventions</h4>
                </section>
            </article>

            <article class="accueilStatCard">
                <section class="iconContainer">
                    <div class="iconCircle">
                        <i class="bi bi-journal-check"></i>
                    </div>
                </section>

                <section class="statContent">
                    <h3>{{ closedInterventionCount }}</h3>
                    <h4>Interventions Clôturées</h4>
                </section>
            </article>
        </div>

        <div class="importBtnWrapper">
            <button type="button" class="btnImport" id="importButton">
                Importer des fiches
            </button>
        </div>

        <div class="backgroundScrollerWrapper">
            <div class="scrollerWrapper">
                <section class="scrollerHeader">
                    <h2 class="scrollerHeaderText">Interventions en cours</h2>
                    <i class="bi bi-arrow-down acc absolute scrollerHeaderArrow"></i>
                    <i class="bi bi-journal-text scrollerHeaderIcon"></i>
                </section>

                <section class="scrollerContent">
                    {% if ongoingInterventions is empty %}
                        <p class="noInterventions">Aucune intervention en cours</p>
                    {% else %}
                        {% for intervention in ongoingInterventions %}
                            <a href="{{ path('app_intervention_show', {'id': intervention.id}) }}" content="intervention" class="scrollerCard" id="{{ intervention.id }}">
                                <section class="scrollerCardInnerCircle">
                                    <span>{{ intervention.client.name|slice(0, 2) }}</span>
                                </section>

                                <section class="scrollerCardContent">
                                    <div>
                                        <h3>{{ intervention.client.name }}</h3>
                                        <h4>{{ intervention.Materiel }}</h4>
                                        <p>{{ intervention.Probleme }}</p>
                                        <span>Ajouté le : {{ intervention.createdAt|date('d/m/Y H:i') }}</span>
                                    </div>

                                    <span class="interStatut">
                                        {% if intervention.statut == 0 %}
                                            <i class="bi bi-x-circle" title="Non traité"></i>
                                            {% elseif intervention.statut == 1 %}
                                            <i class="bi bi-clock" title="En cours"></i>
                                            {% elseif intervention.statut == 2 %}
                                            <i class="bi bi-check-circle" title="Terminé"></i>
                                        {% endif %}
                                    </span>
                                </section>
                            </a>
                        {% endfor %}
                    {% endif %}

                </section>
            </div>
        </div>

        <div id="importModal" class="importModal">
            <div class="importModalContent">
                <span class="importModalClose">&times;</span>
                <div id="importModalBody" class="importModalBody">
                    <!-- Form will be loaded here -->
                </div>
            </div>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/intervention.js') }}"></script>
    <script src="{{ asset('js/client.js') }}"></script>
    <script src="{{ asset('js/import.js') }}"></script>
{% endblock %}