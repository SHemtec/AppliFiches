{% extends 'base.html.twig' %}

{% block title %}Commandes index{% endblock %}

{% block body %}
    <main class="commandesPage">
        <h1>Commandes enregistrées</h1>

        <div class="searchBarWrapper">
            <input type="text" id="searchBar" class="searchBar" placeholder="Rechercher des commandes...">
        </div>

        <article class="commandesWrapper">
            <a id="createCommandeButton" style="width: 20%" class="btn btn-primary">Créer une commande</a>
            {% for commande in commandes %}
                <a href="{{ path('app_commandes_show', {'id': commande.id}) }}" class="commande" id="{{ commande.id }}">
                    <div class="commandeContent">
                        <div class="commandeInfo">
                            <h2>{{ commande.Produits }}</h2>
                            <span>Fournisseur : {{ commande.fournisseur }}</span>
                            <span class="date">Ajouté le : {{ commande.createdAt ? commande.createdAt|date('d/m/Y H:i') : '' }}</span>
                            <span class="date">Commandé le : {{ commande.orderedAt ? commande.orderedAt|date('d/m/Y H:i') : '' }}</span>
                            <span class="status {{ commande.status ? 'status-commande' : 'status-non-commande' }}">
                                {{ commande.status ? 'Commandé' : 'Pas commandé' }}
                            </span>
                            <span class="status {{ commande.deliveryStatus ? 'status-livree' : 'status-non-livree' }}">
                                {{ commande.deliveryStatus ? 'Livré' : 'Pas livré' }}
                            </span>
                            <span class="status {{ commande.clientCalledStatus ? 'status-client-appele' : 'status-client-non-appele' }}">
                                {{ commande.clientCalledStatus ? 'Client prévenu' : 'Client non prévenu' }}
                            </span>

                            {% if commande.intervention %}
                                <div class="interventionDetails">
                                    <span><strong>{{ commande.intervention.client.name }}:</strong></span>
                                    <span> {{ commande.intervention.materiel }}</span>
                                    <span> {{ commande.intervention.probleme }}</span>
                                </div>
                            {% endif %}

                            <section class="commandeButtonWrapper">
                                {% if not commande.status %}
                                    <form action="{{ path('app_commandes_validate', {'id': commande.id}) }}" method="post">
                                        <button type="submit" class="btn btn-primary">Marquer comme Commandée</button>
                                    </form>
                                {% endif %}

                                {% if commande.deliveryStatus == false %}
                                    <form action="{{ path('app_commandes_validate_delivery', {'id': commande.id}) }}" method="post">
                                        <button type="submit" class="btn btn-primary">Valider la livraison</button>
                                    </form>
                                {% endif %}

                                {% if commande.clientCalledStatus == false %}
                                    <form action="{{ path('app_commandes_validate_call', {'id': commande.id}) }}" method="post">
                                        <button type="submit" class="btn btn-primary">Valider l'appel</button>
                                    </form>
                                {% endif %}
                            </section>
                        </div>
                    </div>
                </a>
            {% else %}
                <p class="noCommandes">Aucune commande trouvée</p>
            {% endfor %}
        </article>
    </main>

    <div id="createCommandeModal" class="commandeModal">
        <div class="commandeModalContent">
            <span class="commandeModalClose">&times;</span>
            <div id="createCommandeModalBody" class="commandeModalBody">
                <!-- Form will be loaded here -->
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/commande.js') }}"></script>
    <script src="{{ asset('js/recherche.js') }}"></script>
{% endblock %}