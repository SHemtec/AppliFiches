{% extends 'base.html.twig' %}

{% block title %}Commandes index{% endblock %}

{% block body %}

    <main>

        <div class="searchBarWrapper">
            <input type="text" id="searchBar" class="searchBar" placeholder="Rechercher des commandes...">
        </div>


        <div class="backgroundScrollerWrapper">
            <div class="scrollerWrapper">
                <section class="scrollerHeader">
                    <h2 class="scrollerHeaderText">Commandes enregistrées</h2>
                    <i class="bi bi-arrow-down acc absolute scrollerHeaderArrow"></i>
                    <a id="createCommandeButton" style="cursor: pointer" class="bi bi-plus scrollerHeaderIcon"></a>
                </section>

                <section class="scrollerContent">
                    {% for commande in commandes %}
                        <a href="{{ path('app_commandes_show', {'id': commande.id}) }}" class="scrollerCard commandScrollerCard" id="{{ commande.id }}">
                            <section class="scrollerCardInnerCircle">
                                <span>CC</span>
                            </section>

                            <section class="scrollerCardContent">
                                <div>
                                    <h3>{{ commande.Produits }}</h3>
                                    <h4>{{ commande.fournisseur }}</h4>
                                    <span class="createdAt">Ajouté le : {{ commande.createdAt ? commande.createdAt|date('d/m/Y H:i') : '' }}</span>
                                    <span class="orderedAt"> Commandé le : {{ commande.orderedAt ? commande.orderedAt|date('d/m/Y H:i') : '' }}</span>
                                    <h4 class="ordered {{ commande.status ? 'status-commande' : 'status-non-commande' }}">{{ commande.status ? 'Commandé' : 'Pas commandé' }}</h4>
                                    <h4 class="delivered {{ commande.deliveryStatus ? 'status-livree' : 'status-non-livree' }}">{{ commande.deliveryStatus ? 'Livré' : 'Pas livré' }}</h4>
                                    <h4 class="called {{ commande.clientCalledStatus ? 'status-client-appele' : 'status-client-non-appele' }}">{{ commande.clientCalledStatus ? 'Client prévenu' : 'Client non prévenu' }}</h4>
                                    {% if commande.intervention %}
                                        <h3 class="details"> <i class="bi bi-person"></i>
                                            <strong>{{ commande.intervention.client.name }}:</strong>
                                             {{ commande.intervention.materiel }}
                                             {{ commande.intervention.probleme }}
                                        </h3>
                                    {% endif %}
                                </div>

                                <span class="interStatut cmdStatus">
                                    <i class="bi bi-check-circle" title="Terminé"></i>
                                </span>
                            </section>
                        </a>
                    {% else %}
                        <p class="noCommandes">Aucune commande trouvée</p>
                    {% endfor %}
                </section>
            </div>
        </div>

    </main>
    <div id="createCommandeModal" class="commandeModal">
        <div class="commandeModalContent">
            <span class="commandeModalClose">&times;</span>
            <div id="createCommandeModalBody" class="commandeModalBody">
                <!-- Form will be loaded here -->
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/commande.js') }}"></script>
    <script src="{{ asset('js/recherche.js') }}"></script>
{% endblock %}