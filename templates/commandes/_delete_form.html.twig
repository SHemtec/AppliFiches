<form method="post" action="{{ path('app_commandes_delete', {'id': commande.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commande.id) }}">
    <button style="background: transparent; border: none; cursor: pointer; display: grid; place-items: center; font-size: 1em; color: var(--acc)"><i class="bi bi-x-circle-fill"></i></button>
</form>
