{% extends 'base.html.twig' %}

{% block title %}Commande{% endblock %}

{% block body %}
    <main>
        <div class="clientWrap">
            <article class="card">
                <div class="cardSection contentSection">
                    <section class="cardCircle">
                        <i class="bi bi-truck"></i>
                    </section>
                    <h2 class="">{{ commande.Produits }}</h2>
                    <h3 class="">Ajouté le : {{ commande.createdAt|date('d/m/Y H:i') }}</h3>
                    <h3 class="">Commandé le : {{ commande.orderedAt ? commande.orderedAt|date('d/m/Y H:i') : 'Non commandé' }}</h3>
                    {% if commande.intervention %}<h4><strong>Intervention:</strong> <a style="text-underline: #007bff; color: var(--acc)" href="{{ path('app_intervention_show', {'id': commande.intervention.id}) }}">{{ commande.intervention.Materiel }}</a></h4> {% endif %}
                    {% if commande.status %}
                        <i class="bi bi-check2-circle icon"  title="Completed"></i>
                    {% else %}
                        <i class="bi bi-x-circle icon" title="Pending"></i>
                    {% endif %}
                </div>
            </article>

            <section class="buttons">
                <a href="{{ path('app_commandes_index') }}" class="bi bi-arrow-left"></a>
                {% if not commande.status %}
                    <form action="{{ path('app_commandes_validate', {'id': commande.id}) }}" method="post">
                        <button type="submit" title="valider la commande" style="background: transparent; border: none; cursor: pointer; display: grid; place-items: center; font-size: 1em; color: var(--acc)"><i class="bi bi-bag-check"></i></button>
                    </form>
                {% endif %}

                {% if commande.deliveryStatus == false %}
                    <form action="{{ path('app_commandes_validate_delivery', {'id': commande.id}) }}" method="post">
                        <button type="submit" title="valider la livraison" style="background: transparent; border: none; cursor: pointer; display: grid; place-items: center; font-size: 1em; color: var(--acc)"><i class="bi bi-truck"></i></button>
                    </form>
                {% endif %}

                {% if commande.clientCalledStatus == false %}
                    <form action="{{ path('app_commandes_validate_call', {'id': commande.id}) }}" method="post">
                        <button type="submit" title="valider l'appel au client" style="background: transparent; border: none; cursor: pointer; display: grid; place-items: center; font-size: 1em; color: var(--acc)"><i class="bi bi-telephone"></i></button>
                    </form>
                {% endif %}
                {{ include('commandes/_delete_form.html.twig') }}
            </section>
        </div>
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/commande.js') }}"></script>
{% endblock %}