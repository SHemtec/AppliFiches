<form method="post" action="{{ path('app_intervention_delete', {'id': intervention.id}) }}" onsubmit="return confirm('Voulez vous vraiment supprimer l\'intervention ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ intervention.id) }}">
    <button title="supprimer l'intervention" style="background: transparent; border: none; cursor: pointer; display: grid; place-items: center; font-size: 1em; color: var(--acc)"><i class="bi bi-x-circle-fill"></i></button>
</form>
