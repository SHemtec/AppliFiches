{% extends 'base.html.twig' %}

{% block title %}Intervention index{% endblock %}

{% block body %}
    <main>

        <div class="searchBarWrapper">
            <input type="text" id="searchBar" class="searchBar" placeholder="Rechercher des interventions...">
        </div>

        {% set currentDate = null %}
        {% for intervention in interventions %}
            {% set interventionDate = intervention.createdAt|date('d/m/Y') %}
            {% if currentDate != interventionDate %}
                {% set currentDate = interventionDate %}
                <div class="dateIndicator">
                    <span class="dateLine">{{ currentDate }}</span>
                </div>
            {% endif %}

            <a href="{{ path('app_intervention_show', {'id': intervention.id}) }}" content="intervention" class="scrollerCard interScrollerCard" id="{{ intervention.id }}">
                <section class="scrollerCardInnerCircle">
                    <span>{{ intervention.client.name|slice(0, 2) }}</span>
                </section>

                <section class="scrollerCardContent">
                    <div>
                        <h3>{{ intervention.client.name }}</h3>
                        <h4>{{ intervention.Materiel }}</h4>
                        <p>{{ intervention.Probleme }}</p>
                        <span class="createdAt">Ajouté le : {{ intervention.createdAt|date('d/m/Y H:i') }}</span>
                        {% if intervention.statut == 2 %}
                            <span class="closedAt">Cloturé le : {{ intervention.finishedAt|date('d/m/Y H:i') }}</span>
                        {% endif %}
                    </div>

                    <span class="interStatut">
                                {% if intervention.statut == 0 %}
                                    <i class="bi bi-x-circle" title="Non traité"></i>
                                {% elseif intervention.statut == 1 %}
                                    <i class="bi bi-clock" title="En cours"></i>
                                {% elseif intervention.statut == 2 %}
                                    <i class="bi bi-check-circle" title="Terminé"></i>
                                {% endif %}
                            </span>
                </section>
            </a>
        {% endfor %}
    </main>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/intervention.js') }}"></script>
    <script src="{{ asset('js/recherche.js') }}"></script>
{% endblock %}

